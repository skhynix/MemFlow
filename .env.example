# MemFlow skill retrieval for Claude Code
# Copy to .env in your target project, then set your embedding service details.
# Qdrant is the default backend. No generation LLM is needed.

# Qdrant connection
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=memflow_skills
# QDRANT_API_KEY=your-qdrant-api-key

# Required: an existing OpenAI-compatible embedding service.
# The endpoint, model, dimensions, and API key below are example values.
# Replace them with your embedding service's settings.
# MemFlow calls <VECTOR_EMBEDDING_API_BASE>/embeddings.
VECTOR_EMBEDDING_API_BASE=https://your_endpoint/v1
VECTOR_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
VECTOR_EMBEDDING_DIMENSIONS=2560
# Replace EMPTY if your embedding service requires authentication.
VECTOR_EMBEDDING_API_KEY=EMPTY

# Use the same model and dimensions for registration and retrieval.
# If either changes, use a new collection and register your skills again.

# Optional embedding tuning
# VECTOR_EMBEDDING_MAX_TOKENS=8192

# on = raise instead of silently substituting a hash/zero pseudo-embedding
# when the embedding API fails. Intended for seeding/benchmark runs, but do
# not enable it here: the flag is process-wide and the claude hook shares
# this .env, so search queries would also raise during an embedding outage
# (the hook swallows that and silently reports zero skills). Prefer a
# command-scoped setting instead:
#   MEMFLOW_EMBEDDING_STRICT=on uv run python benchmark/skill_ret_bench/run_seeding.py ...
# MEMFLOW_EMBEDDING_STRICT=off
# Query prefix for instruction-aware embedding models; omit for other models.
# VECTOR_EMBEDDING_QUERY_INSTRUCTION=Given a skill description, retrieve the most relevant skill

# Hybrid search (sparse BM25 + dense RRF fusion)
# on = RRF fusion search; new collections are seeded with BM25 vectors.
# Schema is auto-detected; on an old dense-only collection this falls back
# to dense. Neither this flag nor --clear-existing changes an existing schema.
# Install with uv sync --extra hybrid, then select a separate new collection
# with this flag on to create named dense+sparse vectors. Existing data migration
# is a separate operation; do not drop an existing collection to enable this.
MEMFLOW_HYBRID_SEARCH_ENABLED=off
# FastEmbed model for client-side BM25 sparse vectors.
# QDRANT_SPARSE_MODEL=Qdrant/bm25

# Optional RRF tuning (defaults pre-tuned on SkillRet)
# MEMFLOW_HYBRID_SPARSE_SEARCH_TOP_K=200
# MEMFLOW_HYBRID_DENSE_SEARCH_TOP_K=200
# RRF fusion output depth. Online results are identical for any value >=
# top_k (fusion ranking is limit-independent); it only caps how deep the
# result pool goes. Raise to >= max evaluated K when benchmarking R@200.
# When reranking is on this also caps the reranker input pool
# (min with MEMFLOW_RERANKER_FETCH_TOP_K) — keep the two equal so they
# agree on the candidate pool size.
# MEMFLOW_HYBRID_RRF_TOP_K=100
# Weights "(dense,sparse)" and RRF constant k.
# MEMFLOW_HYBRID_RRF_WEIGHTS=0.6,0.4
# MEMFLOW_HYBRID_RRF_K=60

# Reranker pipeline (applies after dense or hybrid retrieval)
# Pipeline: none(default) | ce | llm | ce_llm | llm_ce
# On SkillRet, llm-only listwise rerank performs best; ce/ce_llm can
# push relevant docs out of the top-10.
MEMFLOW_RERANKER_PIPELINE=none

# Candidate pool depth fed to the reranker. Hybrid path uses
# min(RRF_TOP_K, this); dense path over-fetches via max(top_k, this).
# Keep equal to RRF_TOP_K to avoid a silent cap when hybrid is on.
# MEMFLOW_RERANKER_FETCH_TOP_K=100

# Doc text scope per reranker stage: full | meta (title+desc) | body.
# Code defaults are per-stage SkillRet optima (CE=full, LLM=meta); set
# only to override. Per-stage vars win over the global one.
# MEMFLOW_RERANKER_SCOPE=meta
# MEMFLOW_RERANKER_CE_SCOPE=full
# MEMFLOW_RERANKER_LLM_SCOPE=meta

# Optional reranker tuning (defaults in code)
# MEMFLOW_RERANKER_DOC_CAP=2000
# MEMFLOW_RERANKER_TIMEOUT=60

# Per-stage output Top-K (0 = keep full list; caller's top_k truncates final).
# NOTE: the final output is min(caller top_k, every stage cap) — a stage cap
# below what the caller asks for silently reduces the delivered results.
# The Claude Code hook asks for candidate_k skills (default 20), so on the
# hook path keep the last stage's cap >= candidate_k, or set it to 0 (no
# cap) and let the hook control depth. A warning is logged once when a
# cap falls below the caller's request.
# MEMFLOW_RERANKER_CE_TOP_K=10
# MEMFLOW_RERANKER_LLM_TOP_K=10

# CE Reranker (cross-encoder /v1/score; e.g. vLLM with --task score)
# RERANKER_CE_MODEL=Qwen/Qwen3-Reranker-4B
# RERANKER_CE_API_BASE=http://localhost:8002/v1
# RERANKER_CE_API_KEY=

# LLM Reranker (listwise prompt rerank via /v1/chat/completions; falls back to LLM_* when unset)
# RERANKER_LLM_PROVIDER=openai-compatible
# RERANKER_LLM_MODEL=zai-org/GLM-4.7-Flash
# RERANKER_LLM_API_BASE=http://localhost:8000/v1
# RERANKER_LLM_API_KEY=

# Sampling temperature for the rerank chat call. Default 0.0 (greedy =
# deterministic ranking); always sent explicitly so the vLLM server
# default (1.0 = sampling) cannot leak in. Does not fall back to LLM_*.
# RERANKER_LLM_TEMPERATURE=0.0

# Char budget for the whole listwise prompt (~FETCH_TOP_K x DOC_CAP).
# Over budget logs a warning — an over-long request fails and rerank
# silently falls back to retrieval order. Default fits 128K-token models.
# RERANKER_LLM_MAX_PROMPT_CHARS=300000

# Optional: direct use of memflow.memmachine_memory.MemMachineMemoryClient only.
# These settings are not used by skill retrieval, Claude hooks, MCP, or benchmarks.
# from_env() reads the process environment; load any env file explicitly first.
# The project must already exist. search() also requires an explicit user_id
# and that server's user-specific semantic set_metadata mapping.
# MEMMACHINE_BASE_URL=http://localhost:8080
# MEMMACHINE_ORG_ID=default
# MEMMACHINE_PROJECT=memflow
# MEMMACHINE_API_KEY=your-memmachine-api-key
