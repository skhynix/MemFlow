# MemFlow Environment Configuration
# Copy this file to .env and customize as needed
# cp .env.example .env

# ===========================================
# LLM Configuration
# ===========================================
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=

# ===========================================
# Backend Configuration
# ===========================================
# Choose one: emulated(default) | file | memmachine | qdrant
MEMFLOW_BACKEND=emulated

# File Backend (MEMFLOW_BACKEND=file)
MEMFLOW_FILE_DIR=./file_data

# MemMachine Backend (MEMFLOW_BACKEND=memmachine)
MEMMACHINE_BASE_URL=http://localhost:8080
MEMMACHINE_ORG_ID=default
MEMMACHINE_PROJECT=memflow
MEMMACHINE_API_KEY=

# ===========================================
# Vector DB Embedding Configuration (shared)
# ===========================================
# Common embedding settings used by all vector DB backends (Qdrant).
VECTOR_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# Required: no default. Set to your OpenAI-compatible embedding server.
VECTOR_EMBEDDING_API_BASE=http://localhost:8001/v1
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_DIMENSIONS=2560
# Chunk long texts, embed per chunk, then mean-pool. Default matches Qwen3-Embedding-4B context.
VECTOR_EMBEDDING_MAX_TOKENS=8192
# Query instruction prefix for Qwen3-Embedding instruction-aware models.
# Prepended to search queries as: "Instruct: {instruction}\nQuery: {query}"
# Leave empty/unset for backward-compatible behavior (no prefix).
# VECTOR_EMBEDDING_QUERY_INSTRUCTION=Given a skill description, retrieve the most relevant skill

# ===========================================
# Qdrant Backend (MEMFLOW_BACKEND=qdrant)
# ===========================================
QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=
# QDRANT_DISTANCE: Cosine(default) | Dot | Euclid
# QDRANT_DISTANCE=Cosine

# ===========================================
# Collection / Table Configuration
# ===========================================
# Qdrant
QDRANT_COLLECTION_NAME=skills_qdrant
# QDRANT_INDEX_TYPE: "hnsw"(default) or "flat"
QDRANT_INDEX_TYPE=hnsw
# Max connections per HNSW layer.
QDRANT_INDEX_M=16
# Search depth during index build.
QDRANT_INDEX_EF_CONSTRUCT=100
